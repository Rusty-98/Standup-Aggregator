# Dailies Environment Configuration

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_PATH=./dailies.db
SESSION_SECRET=c1f4e0c382f6e5a1b3d7890abcdef1234567890abcdef1234567890abcdef12
ORG_TIMEZONE=Asia/Kolkata
DIGEST_TIME=20:00
WORK_DAYS=1,2,3,4,5
ALLOWED_EMAIL_DOMAINS=ampcuscyber.com,company.com,gmail.com,example.com

# SMTP Settings (Outlook / Office 365 or MailHog test SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_email@outlook.com
SMTP_PASS=your_app_password
SMTP_SECURE=false
MAIL_FROM="Dailies <your_email@outlook.com>"

# Scheduler. Must be the string true or no reminder/digest jobs run.
# Teams webhook URL, reminder time, and message text are saved per team in /admin, not here.
# APP_URL must match the browser origin. Other origins are rejected on POST/PATCH/DELETE.
ENABLE_CRON=true
LOG_LEVEL=info

# Nightly Excel digest archive directory (default ./exports locally, /data/exports in Docker)
EXPORT_DIR=./exports

# Optional: seed creates this admin if none exists
ADMIN_EMAIL=

# Optional: Recap page AI analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
